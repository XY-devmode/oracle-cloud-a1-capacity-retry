# OCI account and authentication profile
TENANCY_NAME=your-tenancy-name
COMPARTMENT_ID=replace-with-your-compartment-ocid
REGION=your-home-region
OCI_CONFIG_FILE=/absolute/path/to/oci/config
OCI_PROFILE=DEFAULT
OCI_BIN=

# Target compute request
SHAPE=VM.Standard.A1.Flex
OCPUS=2
MEMORY_GB=12
TOTAL_OCPU_LIMIT=2
TOTAL_MEMORY_LIMIT=12
DISPLAY_NAME=a1-capacity-retry
SSH_KEY_FILE=/absolute/path/to/ssh-public-key.pub

# Existing network/image; leave IDs empty to resolve them dynamically
SUBNET_ID=
IMAGE_ID=
IMAGE_OS="Oracle Linux"
IMAGE_OS_VERSION=9
ASSIGN_PUBLIC_IP=true

# Availability domains, comma-separated. Use the exact names from your tenancy.
ADS=AD-1,AD-2,AD-3

# Retry and OCI API behavior
SLEEP_SECONDS=30
MAX_RETRY_DELAY_SECONDS=180
CAPACITY_REQUEST_DELAY_SECONDS=10
OCI_READ_TIMEOUT=30
OCI_NO_RETRY=1
LAUNCH_WAIT_STATE=RUNNING
LAUNCH_MAX_WAIT_SECONDS=120
NETWORK_RECHECK_DELAYS=5,10,20
DRY_RUN=0
LOCK_FILE=/tmp/oci_capacity_retry.lock

# Network bootstrap settings
VCN_NAME=a1-vcn
SUBNET_NAME=a1-public
GATEWAY_NAME=a1-igw
SECURITY_LIST_NAME=a1-ssh
SSH_SOURCE_CIDR=0.0.0.0/0
VCN_CIDR_BLOCK=10.0.0.0/16
SUBNET_CIDR_BLOCK=10.0.1.0/24
VCN_DNS_LABEL=a1vcn
SUBNET_DNS_LABEL=a1sub
